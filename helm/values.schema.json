{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "poundcake",
  "type": "object",
  "required": [
    "secrets"
  ],
  "properties": {
    "poundcake": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full resource name"
    },
    "poundcakeImage": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "default": "ghcr.io/rackerlabs/poundcake"
        },
        "tag": {
          "type": "string",
          "default": ""
        },
        "digest": {
          "type": "string",
          "default": ""
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "Never",
            "IfNotPresent"
          ],
          "default": "Always"
        },
        "pullSecrets": {
          "type": "array",
          "description": "Image pull secrets for PoundCake workloads",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "securityContext": {
          "type": "object",
          "properties": {
            "runAsNonRoot": {
              "type": "boolean"
            },
            "runAsUser": {
              "type": "integer"
            },
            "allowPrivilegeEscalation": {
              "type": "boolean"
            },
            "readOnlyRootFilesystem": {
              "type": "boolean",
              "default": false
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "drop": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "uiImage": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "default": "ghcr.io/rackerlabs/poundcake-ui"
        },
        "tag": {
          "type": "string",
          "default": ""
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "Never",
            "IfNotPresent"
          ],
          "default": "IfNotPresent"
        },
        "containerPort": {
          "type": "integer",
          "default": 8080
        },
        "runtimeWritablePaths": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "securityContext": {
          "type": "object",
          "properties": {
            "runAsNonRoot": {
              "type": "boolean"
            },
            "runAsUser": {
              "type": "integer"
            },
            "allowPrivilegeEscalation": {
              "type": "boolean"
            },
            "readOnlyRootFilesystem": {
              "type": "boolean",
              "default": false
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "drop": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "properties": {
        "mariadb": {
          "type": "string"
        },
        "mongodb": {
          "type": "string"
        },
        "rabbitmq": {
          "type": "string"
        },
        "alpine": {
          "type": "string"
        },
        "busybox": {
          "type": "string"
        },
        "kubectl": {
          "type": "string"
        }
      }
    },
    "utilitySecurityContext": {
      "type": "object",
      "description": "Container security context for utility/init containers and startup jobs",
      "properties": {
        "runAsNonRoot": {
          "type": "boolean",
          "default": true
        },
        "runAsUser": {
          "type": "integer",
          "default": 1000
        },
        "allowPrivilegeEscalation": {
          "type": "boolean",
          "default": false
        },
        "readOnlyRootFilesystem": {
          "type": "boolean",
          "default": false
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": [
        "dbRootPassword",
        "dbName",
        "dbMigratorUser",
        "dbMigratorPassword",
        "dbPluginRegistryUser",
        "dbPluginRegistryPassword",
        "dbApiUser",
        "dbApiPassword",
        "dbAuthVerifierUser",
        "dbAuthVerifierPassword",
        "dbServiceIdentityManagerUser",
        "dbServiceIdentityManagerPassword",
        "dbCredentialManagerUser",
        "dbCredentialManagerPassword",
        "dbPluginOperationUser",
        "dbPluginOperationPassword",
        "dbPrepChefReaderUser",
        "dbPrepChefReaderPassword",
        "dbTimerReaderUser",
        "dbTimerReaderPassword",
        "dbExpediterRunnerReaderUser",
        "dbExpediterRunnerReaderPassword",
        "dbDishwasherReaderUser",
        "dbDishwasherReaderPassword",
        "dbReadonlyUser",
        "dbReadonlyPassword"
      ],
      "properties": {
        "dbRootPassword": {
          "type": "string",
          "description": "Root password for MySQL/MariaDB"
        },
        "dbName": {
          "type": "string",
          "default": "poundcake"
        },
        "dbMigratorUser": {
          "type": "string",
          "default": "poundcake_migrator"
        },
        "dbMigratorPassword": {
          "type": "string",
          "description": "Migrator database user password"
        },
        "dbPluginRegistryUser": {
          "type": "string",
          "default": "poundcake_plugin_registry"
        },
        "dbPluginRegistryPassword": {
          "type": "string",
          "description": "Plugin registry database user password"
        },
        "dbApiUser": {
          "type": "string",
          "default": "poundcake_api"
        },
        "dbApiPassword": {
          "type": "string",
          "description": "API database user password"
        },
        "dbAuthVerifierUser": {
          "type": "string",
          "default": "poundcake_auth_verifier"
        },
        "dbAuthVerifierPassword": {
          "type": "string",
          "description": "Auth verifier database user password"
        },
        "dbServiceIdentityManagerUser": {
          "type": "string",
          "default": "poundcake_service_identity_manager"
        },
        "dbServiceIdentityManagerPassword": {
          "type": "string",
          "description": "Service identity manager database user password"
        },
        "dbCredentialManagerUser": {
          "type": "string",
          "default": "poundcake_credential_manager"
        },
        "dbCredentialManagerPassword": {
          "type": "string",
          "description": "Credential Manager database user password"
        },
        "dbPluginOperationUser": {
          "type": "string",
          "default": "poundcake_plugin_operation"
        },
        "dbPluginOperationPassword": {
          "type": "string",
          "description": "Plugin operation database user password"
        },
        "dbPrepChefReaderUser": {
          "type": "string",
          "default": "poundcake_prep_chef_reader"
        },
        "dbPrepChefReaderPassword": {
          "type": "string",
          "description": "Prep chef reader database user password"
        },
        "dbTimerReaderUser": {
          "type": "string",
          "default": "poundcake_timer_reader"
        },
        "dbTimerReaderPassword": {
          "type": "string",
          "description": "Timer reader database user password"
        },
        "dbExpediterRunnerReaderUser": {
          "type": "string",
          "default": "poundcake_expediter_runner_reader"
        },
        "dbExpediterRunnerReaderPassword": {
          "type": "string",
          "description": "Expediter runner reader database user password"
        },
        "dbDishwasherReaderUser": {
          "type": "string",
          "default": "poundcake_dishwasher_reader"
        },
        "dbDishwasherReaderPassword": {
          "type": "string",
          "description": "Dishwasher reader database user password"
        },
        "dbReadonlyUser": {
          "type": "string",
          "default": "poundcake_readonly"
        },
        "dbReadonlyPassword": {
          "type": "string",
          "description": "Readonly database user password"
        },
        "pluginCredentialEncryptionKey": {
          "type": "string",
          "description": "Adapter credential encryption key"
        },
        "serviceIdentityCredentialEncryptionKey": {
          "type": "string",
          "description": "Internal service identity credential encryption key"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "storageClassName": {
          "type": "string",
          "description": "Default storage class for all PVCs"
        },
        "mariadb": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "accessMode": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "mongo": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "accessMode": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "rabbitmq": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "accessMode": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "config": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "accessMode": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        }
      }
    },
    "longhorn": {
      "type": "object",
      "properties": {
        "rwxStorageClass": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "isDefaultClass": {
              "type": "boolean"
            },
            "numberOfReplicas": {
              "type": "string"
            },
            "staleReplicaTimeout": {
              "type": "string"
            },
            "fsType": {
              "type": "string"
            },
            "dataLocality": {
              "type": "string"
            },
            "migratable": {
              "type": "string"
            },
            "reclaimPolicy": {
              "type": "string"
            },
            "volumeBindingMode": {
              "type": "string"
            },
            "allowVolumeExpansion": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "servicePluginRbac": {
      "type": "object",
      "description": "Cluster API permissions granted to the PoundCake service account for external service plugins.",
      "properties": {
        "prometheusRules": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "podActions": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "workloadTriage": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "nodeTriage": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "description": "External Prometheus and Alertmanager backend URLs for plugin health/config validation.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "prometheus": {
          "type": "object",
          "properties": {
            "url": {"type": "string"},
            "crdNamespace": {"type": "string"}
          }
        },
        "alertmanager": {
          "type": "object",
          "properties": {
            "url": {"type": "string"}
          }
        }
      }
    },
    "bakery": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "activeProvider": {"type": "string"}
          }
        },
        "client": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean", "default": false},
            "baseUrl": {"type": "string"},
            "verifySsl": {"type": "boolean", "default": true},
            "requestTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
            "maxRetries": {"type": "integer", "minimum": 0, "maximum": 10},
            "pollIntervalSeconds": {"type": "number", "minimum": 0.1, "maximum": 60},
            "pollTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "pluginId": {"type": "string"},
            "allowInsecureHttp": {"type": "boolean"},
            "monitor": {
              "type": "object",
              "properties": {
                "id": {"type": "string"},
                "environmentLabel": {"type": "string"},
                "region": {"type": "string"},
                "clusterName": {"type": "string"},
                "tags": {"type": "array", "items": {"type": "string"}}
              }
            },
            "auth": {
              "type": "object",
              "properties": {
                "existingSecret": {"type": "string"},
                "secretKeys": {
                  "type": "object",
                  "properties": {
                    "monitorId": {"type": "string"},
                    "monitorUuid": {"type": "string"},
                    "keyId": {"type": "string"},
                    "secret": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "description": "Explicit browser UI origins allowed to call the PoundCake API via CORS.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "http://poundcake.local",
            "http://ui.poundcake.local",
            "https://poundcake.local",
            "https://ui.poundcake.local"
          ]
        }
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "publishNotReadyAddresses": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "ui": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        }
      }
    },
    "poundcakeApi": {
      "type": "object",
      "properties": {
        "readiness": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0,
              "default": 5
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "gatewayName": {
          "type": "string",
          "default": "poundcake-gateway"
        },
        "gatewayNamespace": {
          "type": "string",
          "default": ""
        },
        "listener": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "default": ""
            },
            "hostname": {
              "type": "string",
              "default": ""
            }
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "listeners": {
          "type": "object",
          "properties": {
            "api": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "hostname": {
                  "type": "string",
                  "default": "api.poundcake.local"
                },
                "port": {
                  "type": "integer",
                  "default": 80
                },
                "protocol": {
                  "type": "string",
                  "enum": [
                    "HTTP",
                    "HTTPS"
                  ],
                  "default": "HTTP"
                },
                "tls": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "default": "Terminate"
                    },
                    "secretName": {
                      "type": "string",
                      "default": ""
                    }
                  }
                },
                "pathPrefix": {
                  "type": "string",
                  "default": "/"
                },
                "requestTimeout": {
                  "type": "string",
                  "default": "300s"
                },
                "backendRequestTimeout": {
                  "type": "string",
                  "default": "300s"
                }
              }
            },
            "ui": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "hostname": {
                  "type": "string",
                  "default": "ui.poundcake.local"
                },
                "port": {
                  "type": "integer",
                  "default": 80
                },
                "protocol": {
                  "type": "string",
                  "enum": [
                    "HTTP",
                    "HTTPS"
                  ],
                  "default": "HTTP"
                },
                "tls": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "default": "Terminate"
                    },
                    "secretName": {
                      "type": "string",
                      "default": ""
                    }
                  }
                },
                "pathPrefix": {
                  "type": "string",
                  "default": "/"
                }
              }
            }
          }
        }
      }
    },
    "prepChef": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "replicaCount": {
          "type": "integer",
          "default": 1,
          "minimum": 0
        },
        "interval": {
          "type": "integer",
          "default": 5,
          "minimum": 1
        }
      }
    },
    "timer": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "replicaCount": {
          "type": "integer",
          "default": 1,
          "minimum": 0
        },
        "interval": {
          "type": "integer",
          "default": 10,
          "minimum": 1
        }
      }
    },
    "expediterRunner": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "replicaCount": {
          "type": "integer",
          "default": 1,
          "minimum": 0
        },
        "interval": {
          "type": "integer",
          "default": 2,
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1
        }
      }
    },
    "dishwasher": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "replicaCount": {
          "type": "integer",
          "default": 1,
          "minimum": 0
        },
        "interval": {
          "type": "integer",
          "default": 300,
          "minimum": 1
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "ingredientsDir": {
          "type": "string",
          "default": "/app/bootstrap/ingredients"
        },
        "recipesDir": {
          "type": "string",
          "default": "/app/bootstrap/recipes"
        },
        "remoteSyncEnabled": {
          "type": "boolean",
          "default": true
        },
        "rulesRepoUrl": {
          "type": "string",
          "default": ""
        },
        "rulesBranch": {
          "type": "string",
          "default": "main"
        },
        "rulesPath": {
          "type": "string",
          "default": "alerts"
        },
        "poundcakeBootstrap": {
          "type": "object",
          "properties": {
            "defaultDuration": {
              "type": "integer",
              "default": 60
            },
            "defaultTimeout": {
              "type": "integer",
              "default": 300
            },
            "pruneMissing": {
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "intervals": {
      "type": "object",
      "properties": {
        "prepChef": {
          "type": "string"
        },
        "expediterRunner": {
          "type": "string"
        },
        "timer": {
          "type": "string"
        },
        "prepInterval": {
          "type": "string"
        }
      }
    },
    "logFormat": {
      "type": "string",
      "default": "console"
    },
    "resources": {
      "type": "object",
      "description": "Resource requests and limits for containers"
    },
    "nodeSelector": {
      "type": "object",
      "description": "Node selector for pod placement",
      "default": {
        "node-role.kubernetes.io/worker": "worker"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Tolerations for pod placement"
    },
    "affinity": {
      "type": "object",
      "description": "Affinity rules for pod placement"
    },
    "defaultResources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "description": "Security context for all pods",
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "fsGroup": {
          "type": "integer"
        },
        "fsGroupChangePolicy": {
          "type": "string"
        },
        "supplementalGroups": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            }
          }
        }
      }
    },
    "infraSecurityContext": {
      "type": "object",
      "description": "Container security contexts for infrastructure services",
      "properties": {
        "mariadb": {
          "type": "object",
          "properties": {
            "runAsNonRoot": {
              "type": "boolean"
            },
            "runAsUser": {
              "type": "integer",
              "default": 1000
            },
            "allowPrivilegeEscalation": {
              "type": "boolean"
            },
            "readOnlyRootFilesystem": {
              "type": "boolean"
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "drop": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "mongodb": {
          "type": "object",
          "properties": {
            "runAsNonRoot": {
              "type": "boolean"
            },
